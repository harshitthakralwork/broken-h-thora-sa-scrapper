# ==============================================================================
# SPARKXFLOW LEAD INTELLIGENCE ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- Core Security & Database ---
# Generate ADMIN_TOKEN with: python -c "import secrets; print(secrets.token_urlsafe(40))"
ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-24-characters

# SQLite is default for local development. To use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://sparkxflow:YOUR_URL_ENCODED_PASSWORD@localhost:5432/sparkxflow
DATABASE_URL=sqlite:///./sparkxflow.db
POSTGRES_PASSWORD=replace-with-a-separate-long-random-secret

# --- Target Market & Geography ---
TARGET_COUNTRY=IN
TARGET_MARKETS=india
DEFAULT_DISCOVERY_CITY=Bengaluru

# --- Discovery Engine Controls ---
BUSINESS_DISCOVERY_ENABLED=true
AUTONOMOUS_DISCOVERY_ENABLED=true

# --- OpenStreetMap Overpass Provider ---
# Supported providers: public_overpass (default), overpass_ch
OVERPASS_PROVIDER=public_overpass
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=SparkXFlowLeadEngine/1.0
OVERPASS_TIMEOUT_SEC=30.0

# --- Overpass.ch Configuration (Optional dedicated tier; unconfigured by default) ---
# OVERPASS_CH_API_KEY=
# OVERPASS_CH_ENDPOINT_TEMPLATE=https://api.overpass.ch/v1/{api_key}/interpreter
# OVERPASS_CH_MONTHLY_BUDGET=10000
# OVERPASS_CH_RATE_LIMIT_PER_MIN=30
# OVERPASS_CH_TIMEOUT_SEC=30.0
# OVERPASS_CACHE_TTL_SEC=3600

# --- Wikidata Knowledge Graph Discovery (CC0 Open Domain) ---
WIKIDATA_USER_AGENT=SparkXFlowLeadEngine/1.0 (https://sparkxflow.local; contact@sparkxflow.local)

# --- OutLead-Inspired Bulk Discovery Credentials (Optional API tiers) ---
# Unconfigured by default; engine fails closed safely without synthetic generation.
# GOOGLE_PLACES_API_KEY=
# SERPAPI_API_KEY=
# OUTLEAD_API_KEY=

# --- Outreach Safety Safeguards ---
# MANDATORY SAFETY: Automatic outbound email sending MUST remain false by default.
EMAIL_SENDING_ENABLED=false

# Optional Gmail / SMTP Provider Credentials (used only when explicit approval is granted)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# --- Webhook & Workflow Integrations ---
# Google Apps Script Webhook URL (from Google Sheet Extensions > Apps Script)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# Dedicated webhook secret for Google Sheets (NEVER reuse ADMIN_TOKEN)
# SHEETS_WEBHOOK_SECRET=your-random-webhook-secret-here
# Target Spreadsheet ID
# GOOGLE_SHEET_ID=1jSxjVQUi-RgQzTmOx42nla3JwguIhIkbqNJXlkxPPgk

# n8n Automation Webhook URL (from n8n Webhook Trigger node)
# N8N_WEBHOOK_URL=
